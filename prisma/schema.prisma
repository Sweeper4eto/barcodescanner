generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  USER
}

enum ClientRole {
  OWNER
  MEMBER
}

model User {
  id                  String      @id @default(cuid())
  username            String      @unique
  email               String?
  passwordHash        String
  role                Role        @default(USER)
  clientRole          ClientRole?
  active              Boolean     @default(true)
  mustChangePassword  Boolean     @default(false)
  clientId            String?
  client              Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  storeLinks          UserStore[]
  pushSubscriptions   PushSubscription[]
  pushNotificationLogs PushNotificationLog[]
  auditLogs           AuditLog[]
  supportRequests     SupportRequest[]
  /** Expiry push notification preferences (phases 1–3). */
  expiryNotifyEarlyEnabled     Boolean @default(true)
  expiryNotifyEarlyDays        Int     @default(14)
  expiryNotifyUrgentEnabled    Boolean @default(true)
  expiryNotifyUrgentDays       Int     @default(3)
  expiryNotifySchedule         String  @default("daily")
  expiryNotifyTime1            String  @default("09:00")
  expiryNotifyTime2            String  @default("18:00")
  expiryNotifyMinIntervalHours Int     @default(24)
  expiryQuietHoursEnabled      Boolean @default(true)
  expiryQuietHoursStart        String  @default("22:00")
  expiryQuietHoursEnd          String  @default("07:00")
  expiryNotifyTimezone         String  @default("Europe/Sofia")
  /** JSON string[] of store ids; null = all assigned stores. */
  expiryNotifyStoreIdsJson     String?
  expiryNotifyPrefsCustomized  Boolean @default(false)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@unique([email])
  @@index([clientId])
}

model Client {
  id                 String    @id @default(cuid())
  name               String
  phone              String?
  additionalInfo     String?
  active             Boolean   @default(true)
  homeUser           Boolean   @default(false)
  /** When false (default), this client is not required to pay. */
  paymentsRequired   Boolean   @default(false)
  monthlyFeePerStore Float     @default(20)
  /** Defaults copied for new users until they customize notification prefs. */
  expiryDefaultEarlyDays        Int?
  expiryDefaultUrgentDays       Int?
  expiryDefaultSchedule         String?
  expiryDefaultTime1            String?
  expiryDefaultTime2            String?
  expiryDefaultMinIntervalHours Int?
  expiryDefaultQuietEnabled     Boolean?
  expiryDefaultQuietStart       String?
  expiryDefaultQuietEnd         String?
  expiryDefaultTimezone         String?
  users              User[]
  stores             Store[]
  payments           Payment[]
  supportRequests    SupportRequest[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Store {
  id             String           @id @default(cuid())
  clientId       String
  client         Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name           String
  address        String?
  phone          String?
  additionalInfo String?
  active         Boolean          @default(true)
  userLinks      UserStore[]
  inventory      InventoryEntry[]
  buyList        BuyListEntry[]
  favourites     FavouriteProduct[]
  supportRequests SupportRequest[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([clientId])
}

model UserStore {
  userId  String
  storeId String
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store   Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([userId, storeId])
}

model Product {
  id        String           @id @default(cuid())
  barcode   String           @unique
  name      String
  imagePath String?
  inventory InventoryEntry[]
  buyList   BuyListEntry[]
  favourites FavouriteProduct[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([name])
}

model InventoryEntry {
  id         String    @id @default(cuid())
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  barcode    String
  articul    String?
  imagePath  String?
  quantity   Int
  expiryDate DateTime
  enteredAt  DateTime  @default(now())
  removedAt  DateTime?
  priceReducedAt DateTime?
  /** Discount % when price is reduced (5–100). Cleared when priceReducedAt is cleared. */
  priceDiscountPercent Int?
  deletedAt  DateTime?

  @@index([storeId, expiryDate])
  @@index([storeId, removedAt, deletedAt])
}

model FavouriteProduct {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([storeId, productId])
  @@index([storeId])
}

model BuyListEntry {
  id        String    @id @default(cuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  barcode   String
  quantity  Int
  enteredAt DateTime  @default(now())
  removedAt DateTime?
  checkedAt DateTime?

  @@index([storeId, removedAt])
}

model Payment {
  id               String   @id @default(cuid())
  clientId         String
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  year             Int
  month            Int
  activeStoreCount Int
  feePerStore      Float
  discount         Float    @default(0)
  amountPaid       Float
  paidAt           DateTime @default(now())
  notes            String?

  @@unique([clientId, year, month])
}

/** Singleton app settings (id is always 1). */
model AppConfig {
  id              Int      @id @default(1)
  /** When false (default), users are not required to have a paid month. */
  paymentsEnabled Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  locale    String   @default("en")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model PushNotificationLog {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind   String
  sentAt DateTime @default(now())

  @@index([userId, kind, sentAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username   String
  event      String
  ipAddress  String   @default("")
  deviceInfo String   @default("")
  details    String   @default("")
  occurredAt DateTime @default(now())

  @@index([occurredAt])
  @@index([event])
  @@index([username])
}

model SupportRequest {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  storeId      String?
  store        Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  topic        String
  contact      String?
  message      String
  status       String   @default("new")
  adminNote    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  resolvedAt   DateTime?

  @@index([status, createdAt])
  @@index([storeId, createdAt])
  @@index([userId, createdAt])
}

/** Admin CRM overlay for public Minimart store locator locations. */
model MinimartLocatorStore {
  id            String   @id @default(cuid())
  /** Agile Store Locator id from mini-mart.bg */
  externalId    String   @unique
  title         String
  street        String
  city          String
  postalCode    String?
  country       String?
  lat           Float
  lng           Float
  phone         String?
  website       String?
  openHoursJson String?
  slug          String?
  /**
   * Visit CRM status: NOT_VISITED | ACCEPTED | THINKING | REJECTED
   * (Accepted = already active / working with store)
   */
  status        String   @default("NOT_VISITED")
  comment       String   @default("")
  syncedAt      DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([city])
  @@index([status])
}

/** Admin-managed “What’s new” bullets shown once to app users when published. */
model WhatsNewItem {
  id        String   @id @default(cuid())
  /** Stable key from code catalog (`whats-new-catalog.ts`). Null for manual admin rows. */
  sourceKey String?  @unique
  titleEn   String
  titleBg   String
  href      String?
  active    Boolean  @default(false)
  /**
   * Admin deleted this row. Catalog sync must not recreate it from sourceKey.
   */
  suppressed Boolean @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
  @@index([suppressed])
}
